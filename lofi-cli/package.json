{
  "name": "@closeup1202/lofi-cli",
  "version": "0.2.5",
  "description": "CLI for lofi — Method-level latency regressions between deploys",
  "bin": {
    "lofi": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --target node18",
    "dev": "tsup src/index.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/closeup1202/lofi.git",
    "directory": "lofi-cli"
  },
  "homepage": "https://github.com/closeup1202/lofi",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "axios": "^1.15.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
